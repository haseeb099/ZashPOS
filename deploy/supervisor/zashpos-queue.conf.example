; Supervisor program — queue worker for ZashPOS staging (placeholders).
[program:zashpos-staging-queue]
process_name=%(program_name)s_%(process_num)02d
command=php /var/www/zashpos-staging/artisan queue:work --sleep=1 --tries=3 --max-time=3600
autostart=true
autorestart=true
stopasgroup=true
killasgroup=true
user=www-data
numprocs=1
redirect_stderr=true
stdout_logfile=/var/log/supervisor/zashpos-staging-queue.log
stopwaitsecs=3600
