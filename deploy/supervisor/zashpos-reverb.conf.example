; Supervisor program — Reverb for ZashPOS staging (placeholders).
; Bind privately; expose via nginx WebSocket proxy on 443.
[program:zashpos-staging-reverb]
command=php /var/www/zashpos-staging/artisan reverb:start --host=127.0.0.1 --port=8080
autostart=true
autorestart=true
stopasgroup=true
killasgroup=true
user=www-data
redirect_stderr=true
stdout_logfile=/var/log/supervisor/zashpos-staging-reverb.log
stopwaitsecs=10
